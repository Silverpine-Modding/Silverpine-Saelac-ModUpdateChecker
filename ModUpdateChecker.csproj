<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>ModUpdateChecker</AssemblyName>
    <Version>1.0.1</Version>
    <Authors>Saelac; ChatGPT</Authors>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <SilverpineGameDir Condition="'$(SilverpineGameDir)' == ''">$(MSBuildProjectDirectory)\..\..</SilverpineGameDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize><DebugSymbols>false</DebugSymbols><DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests\**\*.cs"/>
    <Reference Include="BepInEx"><HintPath>$(SilverpineGameDir)\BepInEx\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(SilverpineGameDir)\Silverpine_Data\Managed\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(SilverpineGameDir)\Silverpine_Data\Managed\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(SilverpineGameDir)\Silverpine_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(SilverpineGameDir)\Silverpine_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(SilverpineGameDir)\Silverpine_Data\Managed\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(SilverpineGameDir)\Silverpine_Data\Managed\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule"><HintPath>$(SilverpineGameDir)\Silverpine_Data\Managed\UnityEngine.UnityWebRequestModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(SilverpineGameDir)\Silverpine_Data\Managed\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ModdingTools"><HintPath>$(ModdingToolsPath)</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(SilverpineGameDir)\BepInEx\plugins\ModdingTools\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <PropertyGroup>
    <ModdingToolsPath Condition="'$(ModdingToolsPath)' == '' and Exists('$(MSBuildProjectDirectory)\..\ModdingTools\bin\Release\netstandard2.1\ModdingTools.dll')">$(MSBuildProjectDirectory)\..\ModdingTools\bin\Release\netstandard2.1\ModdingTools.dll</ModdingToolsPath>
    <ModdingToolsPath Condition="'$(ModdingToolsPath)' == ''">$(SilverpineGameDir)\BepInEx\plugins\ModdingTools\ModdingTools.dll</ModdingToolsPath>
  </PropertyGroup>
</Project>
